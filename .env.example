# Destino real do formulário de contato e do diagnóstico.
# Aceita qualquer serviço que receba POST em JSON:
#   Formspree:   https://formspree.io/f/SEU_ID
#   Web3Forms:   https://api.web3forms.com/submit   (envie tambem access_key)
#   n8n:         https://seu-n8n/webhook/leads
# Enquanto estiver vazio, os leads ficam apenas no navegador e NAO chegam ate voce.
VITE_LEAD_ENDPOINT=

# Senha do painel (#admin). ATENCAO: fica visivel no codigo do navegador —
# serve so para nao abrir por acidente, nao e protecao real.
VITE_ADMIN_PASSCODE=

# Opcional: persistencia dos leads/planos no Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
